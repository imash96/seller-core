// ============================================================================
// Multi-User E-commerce Operations & Business Management SaaS
// Target Database: PostgreSQL 16+
// Primary Key Strategy: prefixed ULID strings (varchar(64)) generated
//   application-side by generateEntityId() — e.g. ord_01J8ZK9V3Q0M8ZK5N7YQ2W4X6B
// Root Ownership Entity: users (all tenant business data scoped by user_id)
//
// Money: every amount is a self-contained PriceMoney JSONB object
//   { "currency_code": "USD", "amount": 12.34 }
// validated by is_valid_price_money(value, allow_negative). There are no
// standalone currency_code columns on business tables and no EAV price tables.
// Signed amounts are permitted only on net_proceeds, gross_profit, net_profit,
// variance_total, variance_amount and current_balance. catalog_items is USD-only
// (base_price_usd), while products/product_variants/channel_listings carry
// MedusaJS v2 price arrays validated by is_valid_medusa_prices_array; tax_lines
// and adjustments arrays are validated by is_valid_money_entry_array.
// Rates stay decimal: exchange_rate decimal(18,8).
//
// Metric definitions (order-level P&L):
//   gross_sales    = orders.subtotal.amount
//   net_sales      = subtotal - discount - promotion + shipping - shipping_discount
//   net_proceeds   = grand_total - marketplace_fees - payment_processing_fees
//   gross_profit   = net_sales - cogs - shipping_cost
//   net_profit     = net_proceeds - cogs - shipping_cost - tax - shipping_tax
//   reporting_total = grand_total * exchange_rate (self-contained currency)
// ============================================================================

Project seller_core_saas {
  database_type: 'PostgreSQL'
  Note: 'Multi-User E-Commerce Operations, Marketplace Management, Fulfillment & Financial Ledger SaaS'
}

// ----------------------------------------------------------------------------
// ENUMS (must match app/enums/index.ts exactly)
// ----------------------------------------------------------------------------

