// ============================================================================
// Multi-User E-commerce Operations & Business Management SaaS
// Target Database: PostgreSQL 16+
// Primary Key Strategy: prefixed ULID strings (varchar(64)) generated
//   application-side by generateEntityId() — e.g. ord_01J8ZK9V3Q0M8ZK5N7YQ2W4X6B
// Root Ownership Entity: users (all tenant business data scoped by user_id)
//
// Money: decimal(14,2) [rates: decimal(18,8)] — floating point is prohibited.
// Metric definitions (order-level P&L):
//   gross_sales    = orders.subtotal_amount = sum(qty * unit_price)
//   net_sales      = subtotal - discount + shipping_charged
//   net_proceeds   = total - marketplace_fees - payment_processing_fees - refunded
//   gross_profit   = net_sales - cogs - shipping_cost
//   net_profit     = net_proceeds - cogs - shipping_cost - tax
// ============================================================================

Project seller_core_saas {
  database_type: 'PostgreSQL'
  Note: 'Multi-User E-Commerce Operations, Marketplace Management, Fulfillment & Financial Ledger SaaS'
}

// ----------------------------------------------------------------------------
// ENUMS (must match app/enums/index.ts exactly)
// ----------------------------------------------------------------------------

