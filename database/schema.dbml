// ----------------------------------------------------------------------------
// TABLES
// ----------------------------------------------------------------------------

Table users {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  email varchar(255) [not null, unique, note: 'Case-insensitive login identity; stored lowercased']
  full_name varchar(255) [not null]
  company_name varchar(255) [null]
  phone varchar(50) [null]
  password varchar(255) [not null, note: 'Scrypt hash via @adonisjs/core hash; never plaintext']
  status user_status [not null, default: 'pending_activation']
  is_super_admin boolean [not null, default: false, note: 'Only super administrators can provision users and assign roles']
  failed_login_attempts integer [not null, default: 0]
  locked_until timestamptz [null]
  password_changed_at timestamptz [null]
  last_login_at timestamptz [null]
  last_login_ip varchar(64) [null]
  default_currency varchar(3) [not null, default: 'USD']
  timezone varchar(64) [not null, default: 'UTC']
  preferences jsonb [not null, default: `{}`, note: 'UI/dashboard preferences']
  created_by_user_id varchar(64) [null, ref: > users.id, note: 'ON DELETE SET NULL · Provisioning super admin (self-referencing)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    status [name: 'idx_users_status']
    created_by_user_id [name: 'idx_users_created_by']
  }

  // CHECK chk_users_email_lower: email = lower(email)
  // CHECK chk_users_failed_login_nonneg: failed_login_attempts >= 0
  // CHECK chk_users_currency_code: default_currency ~ '^[A-Z]{3}$'

  Note: 'Root ownership entity. Public registration is disabled; only active system super administrators may provision users.'
}

Table roles {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  slug varchar(100) [not null, unique]
  name varchar(150) [not null]
  description text [null]
  is_system boolean [not null, default: false, note: 'System roles cannot be deleted']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'RBAC role definitions. Users may hold multiple roles simultaneously.'
}

Table permissions {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  name varchar(150) [not null]
  slug varchar(150) [not null, unique]
  resource varchar(100) [not null]
  action varchar(100) [not null, note: 'read | create | update | delete | export | * (wildcard)']
  description text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (resource, action) [unique, name: 'uq_permissions_resource_action']
  }

  Note: 'Granular resource.action permission catalog (e.g. orders.read, orders.create, orders.export).'
}

Table role_permissions {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  role_id varchar(64) [not null, ref: > roles.id, note: 'ON DELETE CASCADE']
  permission_id varchar(64) [not null, ref: > permissions.id, note: 'ON DELETE CASCADE']
  effect permission_effect [not null, default: 'allow']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (role_id, permission_id) [unique, name: 'uq_role_permissions_role_perm']
    permission_id [name: 'idx_role_permissions_perm']
  }

  Note: 'Role-permission grants with explicit allow/deny effect. Deny overrides allow across all assigned roles (least-privilege).'
}

Table user_roles {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  role_id varchar(64) [not null, ref: > roles.id, note: 'ON DELETE CASCADE']
  assigned_by_user_id varchar(64) [null, ref: > users.id, note: 'ON DELETE SET NULL']
  expires_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, role_id) [unique, name: 'uq_user_roles_user_role']
    role_id [name: 'idx_user_roles_role']
  }

  Note: 'Many-to-many user/role assignment. Multiple roles per user; optional expiry for temporary elevation (privilege escalation protection).'
}

Table module_entitlements {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  module_key varchar(100) [not null, note: 'orders, customers, catalog, integrations, shipments, returns, finance, household_finance, credit_cards, analytics, tasks, users_rbac']
  is_enabled boolean [not null, default: true]
  plan_tier varchar(64) [not null, default: 'enterprise']
  limits jsonb [not null, default: `{}`, note: 'Per-module usage limits (e.g. max_orders_per_month)']
  expires_at timestamptz [null]
  updated_by_user_id varchar(64) [null, ref: > users.id, note: 'ON DELETE SET NULL']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, module_key) [unique, name: 'uq_module_entitlements_user_module']
  }

  Note: 'Feature-module entitlements, managed independently from RBAC role permissions.'
}

Table user_sessions {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  session_token_hash varchar(128) [not null, unique, note: 'SHA-256 of session token; raw token never stored']
  ip_address varchar(64) [null]
  user_agent text [null]
  is_revoked boolean [not null, default: false]
  revoked_at timestamptz [null]
  expires_at timestamptz [not null]
  last_active_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_user_sessions_user']
    (user_id, is_revoked) [name: 'idx_user_sessions_active']
  }

  Note: 'Session registry supporting immediate revocation on logout, password change, suspension, or lockout.'
}

Table password_reset_tokens {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  token_hash varchar(128) [not null, unique]
  requested_ip varchar(64) [null]
  expires_at timestamptz [not null]
  used_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_password_reset_tokens_user']
  }

  Note: 'Hashed single-use account recovery tokens.'
}

Table audit_logs {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  actor_user_id varchar(64) [null, ref: > users.id, note: 'ON DELETE SET NULL · Authenticated actor (SET NULL retains history after user removal)']
  user_id varchar(64) [null, ref: > users.id, note: 'ON DELETE SET NULL · Tenant owner whose data was affected']
  action varchar(150) [not null, note: 'e.g. auth.login, user.created, order.imported, refund.processed']
  entity_type varchar(100) [not null]
  entity_id varchar(64) [null]
  request_id varchar(100) [null]
  correlation_id varchar(100) [null]
  ip_address varchar(64) [null]
  user_agent text [null]
  before_state jsonb [null]
  after_state jsonb [null]
  metadata jsonb [not null, default: `{}`]
  checksum varchar(64) [not null, note: 'SHA-256 tamper-evident digest']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_audit_logs_user']
    actor_user_id [name: 'idx_audit_logs_actor']
    (entity_type, entity_id) [name: 'idx_audit_logs_entity']
    correlation_id [name: 'idx_audit_logs_correlation']
    created_at [name: 'idx_audit_logs_created_at']
  }

  Note: 'Append-only tamper-evident audit trail. UPDATE/DELETE blocked by trigger; SHA-256 checksum over actor/action/entity/states/timestamp.'
}

Table sales_channels {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  code varchar(50) [not null, unique]
  name varchar(150) [not null]
  channel_type channel_type [not null, default: 'marketplace']
  logo_url text [null]
  supports_oauth boolean [not null, default: true]
  default_config jsonb [not null, default: `{}`, note: 'Channel defaults (fee percentages, API endpoints)']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'System catalog of supported marketplaces and sales channels (amazon, ebay, etsy, website, google_shopping, ...).'
}

Table seller_accounts {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  sales_channel_id varchar(64) [not null, ref: > sales_channels.id, note: 'ON DELETE RESTRICT']
  account_name varchar(150) [not null]
  account_email varchar(150) [null]
  account_phone varchar(150) [null]
  account_code varchar(4) [null, note: 'Short user-facing code for this account']
  external_seller_id varchar(150) [not null, note: 'Marketplace seller/merchant id']
  marketplace_region varchar(32) [not null, default: 'US']
  default_currency varchar(3) [not null, default: 'USD']
  status seller_account_status [not null, default: 'active']
  health_status health_status [not null, default: 'healthy']
  encrypted_credentials text [null, note: 'AES-256-GCM ciphertext of structured credential JSON']
  credential_vault_ref varchar(255) [null, note: 'External KMS/Secrets Manager URI']
  oauth_scopes text [null]
  token_expires_at timestamptz [null]
  last_credential_rotated_at timestamptz [null]
  rate_limit_rpm integer [not null, default: 60]
  retry_policy jsonb [not null, default: `{}`, note: '{maxRetries, backoffMs}']
  sync_checkpoint jsonb [not null, default: `{}`, note: 'Cursor/watermark for resumable syncs']
  sync_config jsonb [not null, default: `{}`]
  last_synced_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, sales_channel_id, external_seller_id, marketplace_region) [unique, name: 'uq_seller_accounts_identity']
    user_id [name: 'idx_seller_accounts_user']
    status [name: 'idx_seller_accounts_status']
  }

  // CHECK chk_seller_accounts_rate_limit: rate_limit_rpm > 0

  Note: 'User-owned marketplace seller accounts. Credentials stored AES-256-GCM encrypted (encrypted_credentials) or via external vault reference — never plaintext.'
}

Table sync_jobs {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  seller_account_id varchar(64) [null, ref: > seller_accounts.id, note: 'ON DELETE SET NULL']
  job_type sync_job_type [not null]
  status sync_job_status [not null, default: 'queued']
  idempotency_key varchar(150) [not null, note: 'Unique per user; retried batches are short-circuited']
  correlation_id varchar(100) [null]
  total_records integer [not null, default: 0]
  processed_records integer [not null, default: 0]
  succeeded_records integer [not null, default: 0]
  failed_records integer [not null, default: 0]
  skipped_duplicates integer [not null, default: 0]
  checkpoint_cursor varchar(255) [null]
  error_summary jsonb [not null, default: `{}`]
  started_at timestamptz [null]
  completed_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, idempotency_key) [unique, name: 'uq_sync_jobs_user_idempotency']
    (user_id, status) [name: 'idx_sync_jobs_user_status']
    seller_account_id [name: 'idx_sync_jobs_seller_account']
  }

  // CHECK chk_sync_jobs_counters_nonneg: total_records >= 0 AND processed_records >= 0 AND succeeded_records >= 0 AND failed_records >= 0 AND skipped_duplicates >= 0

  Note: 'Import/export batch + marketplace synchronization runs with idempotency keys, progress counters and partial-failure reporting.'
}

Table sync_job_errors {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  sync_job_id varchar(64) [not null, ref: > sync_jobs.id, note: 'ON DELETE CASCADE']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  record_index integer [not null, default: 0]
  external_record_id varchar(150) [null]
  error_code varchar(100) [not null]
  error_message text [not null]
  field_errors jsonb [not null, default: `{}`]
  raw_excerpt jsonb [null, note: 'Redacted excerpt of the offending record']
  is_resolved boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    sync_job_id [name: 'idx_sync_job_errors_job']
    user_id [name: 'idx_sync_job_errors_user']
  }

  Note: 'Per-record import/sync validation failures; batches continue past bad records (partial-success semantics).'
}

Table financial_accounts {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  account_name varchar(150) [not null]
  account_type financial_account_type [not null, default: 'bank_checking']
  institution_name varchar(150) [null]
  account_number_last_4 varchar(4) [null, note: 'Only last 4 digits; full account numbers prohibited']
  currency_code varchar(3) [not null, default: 'USD']
  current_balance decimal(14,2) [not null, default: 0.00]
  data_classification data_classification [not null, default: 'business']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_financial_accounts_user']
    (user_id, data_classification) [name: 'idx_financial_accounts_classification']
  }

  // CHECK chk_financial_accounts_last4: account_number_last_4 IS NULL OR account_number_last_4 ~ '^[0-9]{4}$'

  Note: 'Bank, cash, marketplace-clearing and payment-gateway accounts. data_classification separates business vs household/personal money.'
}

Table credit_cards {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  financial_account_id varchar(64) [null, ref: > financial_accounts.id, note: 'ON DELETE SET NULL']
  card_label varchar(150) [not null]
  brand_name varchar(64) [not null]
  issuer_bank varchar(150) [null]
  cardholder_name varchar(150) [not null]
  last_4_digits varchar(4) [not null]
  exp_month integer [not null]
  exp_year integer [not null]
  vault_token_reference varchar(255) [null]
  logo_url text [null]
  currency_code varchar(3) [not null, default: 'USD']
  credit_limit decimal(14,2) [not null, default: 0.00]
  current_balance decimal(14,2) [not null, default: 0.00]
  statement_balance decimal(14,2) [not null, default: 0.00]
  minimum_payment_due decimal(14,2) [not null, default: 0.00]
  billing_cycle_day integer [null]
  payment_due_day integer [null]
  next_payment_due_date date [null]
  reminder_days_before integer [not null, default: 5]
  auto_pay_enabled boolean [not null, default: false]
  data_classification data_classification [not null, default: 'business']
  status credit_card_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_credit_cards_user']
    (user_id, next_payment_due_date) [name: 'idx_credit_cards_due_date']
  }

  // CHECK chk_credit_cards_metadata_valid: exp_month BETWEEN 1 AND 12 AND exp_year BETWEEN 2000 AND 2100 AND last_4_digits ~ '^[0-9]{4}$'
  // CHECK chk_credit_cards_amounts_nonneg: credit_limit >= 0 AND current_balance >= 0 AND statement_balance >= 0 AND minimum_payment_due >= 0

  Note: 'Tokenized credit-card metadata only. Full PAN and CVV are strictly prohibited; vault_token_reference points at a PCI-compliant vault.'
}

Table credit_card_seller_accounts {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  credit_card_id varchar(64) [not null, ref: > credit_cards.id, note: 'ON DELETE CASCADE']
  seller_account_id varchar(64) [not null, ref: > seller_accounts.id, note: 'ON DELETE CASCADE']
  usage_purpose card_channel_usage [not null, default: 'primary_billing']
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (credit_card_id, seller_account_id, usage_purpose) [unique, name: 'uq_card_seller_accounts_purpose']
    seller_account_id [name: 'idx_card_seller_accounts_seller']
  }

  Note: 'Links cards to seller accounts / sales channels with an explicit usage purpose (multiple cards per user and per channel).'
}

Table finance_categories {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  parent_id varchar(64) [null, ref: > finance_categories.id, note: 'ON DELETE SET NULL']
  name varchar(150) [not null]
  slug varchar(150) [not null]
  category_type finance_category_type [not null]
  data_classification data_classification [not null, default: 'business']
  cost_bucket finance_cost_bucket [not null, default: 'operations']
  is_tax_deductible boolean [not null, default: true]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, category_type, slug) [unique, name: 'uq_finance_categories_user_type_slug']
  }

  Note: 'Hierarchical income/expense categories with cost-bucket classification used by profitability reports.'
}

Table customers {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE · Tenant owner']
  external_customer_id varchar(150) [null, note: 'Marketplace buyer id']
  full_name varchar(255) [not null]
  first_name varchar(120) [null]
  last_name varchar(120) [null]
  company_name varchar(200) [null]
  email varchar(255) [null]
  normalized_email varchar(255) [null, note: 'Lowercased/trimmed for identity matching']
  proxy_email varchar(255) [null, note: 'Marketplace relay/anonymized buyer email']
  phone varchar(50) [null]
  normalized_phone varchar(50) [null, note: 'Digits-only identity matching key']
  preferred_currency varchar(3) [not null, default: 'USD']
  orders_count integer [not null, default: 0, note: 'Derived cache maintained by OrderService']
  total_spent decimal(14,2) [not null, default: 0.00, note: 'Derived cache in reporting currency']
  is_repeat_customer boolean [not null, default: false, note: 'Derived cache: orders_count > 1']
  risk_level customer_risk_level [not null, default: 'low']
  risk_score integer [not null, default: 0]
  merged_into_customer_id varchar(64) [null, ref: > customers.id, note: 'ON DELETE SET NULL · Non-destructive duplicate merge pointer; order history is preserved']
  notes text [null]
  metadata jsonb [not null, default: `{}`]
  first_order_at timestamptz [null]
  last_order_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_customers_user']
    (user_id, normalized_email) [name: 'idx_customers_user_norm_email']
    (user_id, normalized_phone) [name: 'idx_customers_user_norm_phone']
    (user_id, external_customer_id) [name: 'idx_customers_user_ext_id']
    (user_id, risk_level) [name: 'idx_customers_user_risk']
    (user_id, merged_into_customer_id) [name: 'idx_customers_user_merged_into']
  }

  // CHECK chk_customers_orders_count_nonneg: orders_count >= 0
  // CHECK chk_customers_total_spent_nonneg: total_spent >= 0
  // CHECK chk_customers_risk_score_nonneg: risk_score >= 0

  Note: 'Normalized customer profiles scoped to one owning user. Duplicate profiles may exist pending human review and non-destructive merge.'
}

Table customer_addresses {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  customer_id varchar(64) [not null, ref: > customers.id, note: 'ON DELETE CASCADE']
  address_type address_type [not null, default: 'both']
  label varchar(100) [null]
  recipient_name varchar(255) [not null]
  company_name varchar(200) [null]
  phone varchar(50) [null]
  line_1 varchar(255) [not null]
  line_2 varchar(255) [null]
  line_3 varchar(255) [null]
  city varchar(150) [not null]
  state_province varchar(150) [null]
  postal_code varchar(50) [not null]
  country_code varchar(2) [not null, default: 'US']
  address_fingerprint varchar(64) [null, note: 'SHA-256 of normalized address components']
  is_default boolean [not null, default: false]
  is_verified boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    customer_id [name: 'idx_customer_addresses_customer']
    (user_id, address_fingerprint) [name: 'idx_customer_addresses_fingerprint']
  }

  Note: 'Multiple shipping/billing addresses per customer. address_fingerprint detects shared addresses (a reviewable risk signal, never an automatic ban).'
}

Table brands {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  name varchar(150) [not null]
  reg_no varchar(150) [null]
  serial_no varchar(150) [null]
  slug varchar(150) [not null]
  logo_url text [null]
  website_url text [null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, slug) [unique, name: 'uq_brands_user_slug']
  }

  Note: 'User-owned brand definitions for catalog organization and brand-level P&L reporting.'
}

Table product_categories {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  parent_category_id varchar(64) [null, ref: > product_categories.id, note: 'ON DELETE SET NULL']
  name varchar(150) [not null]
  slug varchar(150) [not null]
  taxonomy_path varchar(500) [null, note: 'Category handle/path like men/outerwear/jacket']
  attributes_schema jsonb [not null, default: `[]`, note: 'Expected variation attribute names for this category']
  description text [null]
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, slug) [unique, name: 'uq_product_categories_user_slug']
  }

  Note: 'Hierarchical catalog categories. taxonomy_path is the display/SEO category handle (e.g. men/outerwear/jacket).'
}

Table products {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  brand_id varchar(64) [null, ref: > brands.id, note: 'ON DELETE SET NULL']
  category_id varchar(64) [null, ref: > product_categories.id, note: 'ON DELETE SET NULL']
  title varchar(255) [not null, note: 'Storefront/SEO title']
  title_75 varchar(255) [null, note: 'Amazon title-policy variant (max 75)']
  title_80 varchar(255) [null, note: 'eBay title variant (max 80)']
  sub_title varchar(255) [null, note: 'Storefront sub title']
  sub_title_125 varchar(255) [null, note: 'Amazon sub title (max 125)']
  slug varchar(255) [not null]
  sku_prefix varchar(100) [null]
  list_price jsonb [not null, default: `[]`, note: 'Multi-currency list prices: [{currency_code, price}]']
  sale_price jsonb [not null, default: `[]`, note: 'Multi-currency sale prices: [{currency_code, price}]']
  collection_name varchar(100) [null]
  description text [null]
  extended_description text [null, note: 'eBay HTML description']
  short_description text [null]
  status product_status [not null, default: 'draft']
  has_variants boolean [not null, default: false]
  variation_dimensions jsonb [not null, default: `[]`, note: 'e.g. ["color","size"]']
  weight_grams decimal(14,2) [null]
  dimensions_cm jsonb [not null, default: `{}`]
  images jsonb [not null, default: `[]`]
  type varchar(100) [null]
  tags jsonb [not null, default: `[]`]
  metadata jsonb [not null, default: `{}`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, slug) [unique, name: 'uq_products_user_slug']
    (user_id, status) [name: 'idx_products_user_status']
    brand_id [name: 'idx_products_brand']
    category_id [name: 'idx_products_category']
  }

  Note: 'Parent catalog record. Standalone products (has_variants = false) still own exactly one default product_variants SKU so order lines, inventory and listings reference a uniform sellable entity.'
}

Table product_variants {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  product_id varchar(64) [not null, ref: > products.id, note: 'ON DELETE CASCADE']
  sku varchar(120) [not null]
  title varchar(255) [not null]
  is_default boolean [not null, default: false, note: 'True for the single SKU of standalone products']
  barcode_upc_ean varchar(64) [null]
  mpn varchar(100) [null]
  asin varchar(20) [null]
  attributes jsonb [not null, default: `{}`, note: 'Denormalized {attribute: value} map; normalized rows live in product_variant_attributes']
  currency_code varchar(3) [not null, default: 'USD']
  retail_price decimal(14,2) [not null, default: 0.00]
  compare_at_price decimal(14,2) [null]
  cost_price decimal(14,2) [not null, default: 0.00, note: 'Unit purchase cost']
  manufacturing_cost decimal(14,2) [not null, default: 0.00]
  packaging_cost decimal(14,2) [not null, default: 0.00]
  stock_on_hand integer [not null, default: 0]
  stock_reserved integer [not null, default: 0, note: 'Reserved by open orders']
  reorder_point integer [not null, default: 5]
  weight_grams decimal(14,2) [null]
  dimensions_cm jsonb [not null, default: `{}`]
  images jsonb [not null, default: `[]`]
  status variant_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  stock_available integer [not null, note: 'GENERATED ALWAYS AS (Generated: stock_on_hand - stock_reserved) STORED']

  Indexes {
    (user_id, sku) [unique, name: 'uq_product_variants_user_sku']
    product_id [name: 'idx_product_variants_product']
    (user_id, asin) [name: 'idx_product_variants_user_asin']
  }

  // CHECK chk_product_variants_qty_nonneg: stock_on_hand >= 0 AND stock_reserved >= 0 AND reorder_point >= 0
  // CHECK chk_product_variants_prices_nonneg: retail_price >= 0 AND cost_price >= 0 AND manufacturing_cost >= 0 AND packaging_cost >= 0 AND (compare_at_price IS NULL OR compare_at_price >= 0)

  Note: 'Sellable SKU entity referenced by order lines, channel listings and inventory. Prices are explicit numeric columns (no float).'
}

Table product_variant_attributes {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  product_variant_id varchar(64) [not null, ref: > product_variants.id, note: 'ON DELETE CASCADE']
  attribute_name varchar(100) [not null]
  attribute_value varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (product_variant_id, attribute_name) [unique, name: 'uq_variant_attributes_variant_name']
    (user_id, attribute_name, attribute_value) [name: 'idx_variant_attributes_lookup']
  }

  Note: 'Normalized variation attributes (color/size/material/...) enabling relational filtering and indexing.'
}

Table channel_listings {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  seller_account_id varchar(64) [not null, ref: > seller_accounts.id, note: 'ON DELETE CASCADE']
  product_id varchar(64) [not null, ref: > products.id, note: 'ON DELETE CASCADE']
  product_variant_id varchar(64) [not null, ref: > product_variants.id, note: 'ON DELETE CASCADE']
  external_listing_id varchar(150) [not null]
  external_variant_id varchar(150) [null]
  external_sku varchar(150) [null]
  asin varchar(20) [null]
  channel_title varchar(500) [null]
  channel_description text [null]
  channel_category_id varchar(150) [null]
  currency_code varchar(3) [not null, default: 'USD']
  listed_price decimal(14,2) [not null, default: 0.00]
  allocated_quantity integer [not null, default: 0]
  listing_status listing_status [not null, default: 'active']
  publication_status publication_status [not null, default: 'published']
  sync_status entity_sync_status [not null, default: 'synced']
  last_sync_error text [null]
  channel_attributes jsonb [not null, default: `{}`]
  last_synced_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (seller_account_id, external_listing_id, product_variant_id) [unique, name: 'uq_channel_listings_account_ext_variant']
    user_id [name: 'idx_channel_listings_user']
    product_variant_id [name: 'idx_channel_listings_variant']
  }

  Note: 'Per-seller-account listing mapping for one product variant (Amazon ASIN/listing, eBay item id, Etsy listing, storefront URL).'
}

Table orders {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  seller_account_id varchar(64) [null, ref: > seller_accounts.id, note: 'ON DELETE SET NULL']
  customer_id varchar(64) [not null, ref: > customers.id, note: 'ON DELETE RESTRICT · Orders are never orphaned; customers with history merge instead of delete']
  shipping_address_id varchar(64) [null, ref: > customer_addresses.id, note: 'ON DELETE SET NULL']
  billing_address_id varchar(64) [null, ref: > customer_addresses.id, note: 'ON DELETE SET NULL']
  sync_job_id varchar(64) [null, ref: > sync_jobs.id, note: 'ON DELETE SET NULL']
  order_number varchar(100) [not null]
  external_order_id varchar(150) [null, note: 'Marketplace order id; unique per seller account for idempotent imports']
  source_type order_source_type [not null, default: 'manual']
  marketplace_code varchar(50) [not null, default: 'direct']
  status order_status [not null, default: 'pending']
  payment_status order_payment_status [not null, default: 'unpaid']
  fulfillment_status fulfillment_status [not null, default: 'unfulfilled']
  sync_status entity_sync_status [not null, default: 'not_applicable']
  currency_code varchar(3) [not null, default: 'USD']
  reporting_currency_code varchar(3) [not null, default: 'USD']
  exchange_rate decimal(18,8) [not null, default: 1.00000000]
  subtotal_amount decimal(14,2) [not null, default: 0.00, note: 'gross_sales = sum(qty * unit_price)']
  tax_amount decimal(14,2) [not null, default: 0.00]
  discount_amount decimal(14,2) [not null, default: 0.00]
  shipping_charged_amount decimal(14,2) [not null, default: 0.00, note: 'Shipping revenue charged to buyer']
  total_amount decimal(14,2) [not null, default: 0.00, note: 'subtotal - discount + tax + shipping_charged']
  marketplace_fees_amount decimal(14,2) [not null, default: 0.00]
  payment_processing_fees_amount decimal(14,2) [not null, default: 0.00]
  shipping_cost_amount decimal(14,2) [not null, default: 0.00, note: 'Outbound carrier cost']
  cogs_amount decimal(14,2) [not null, default: 0.00]
  refunded_amount decimal(14,2) [not null, default: 0.00]
  net_proceeds_amount decimal(14,2) [not null, default: 0.00, note: 'total - marketplace_fees - payment_fees - refunded']
  gross_profit_amount decimal(14,2) [not null, default: 0.00, note: 'net_sales - cogs - shipping_cost (net_sales = subtotal - discount + shipping_charged)']
  net_profit_amount decimal(14,2) [not null, default: 0.00, note: 'net_proceeds - cogs - shipping_cost - tax']
  reporting_total_amount decimal(14,2) [not null, default: 0.00, note: 'total_amount * exchange_rate']
  shipping_address_snapshot jsonb [null, note: 'Immutable address snapshot at order time']
  buyer_notes text [null]
  internal_notes text [null]
  ordered_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz [null]
  shipped_at timestamptz [null]
  delivered_at timestamptz [null]
  cancelled_at timestamptz [null]
  delivery_notification_sent_at timestamptz [null, note: 'Set when customer delivery message dispatched']
  source_created_at timestamptz [null]
  source_updated_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, order_number) [unique, name: 'uq_orders_user_order_number']
    (seller_account_id, external_order_id) [unique, name: 'uq_orders_seller_external_id', note: 'partial: WHERE external_order_id IS NOT NULL · Partial unique — idempotent marketplace import / duplicate detection']
    (user_id, status) [name: 'idx_orders_user_status']
    (user_id, ordered_at) [name: 'idx_orders_user_ordered_at']
    customer_id [name: 'idx_orders_customer']
    sync_job_id [name: 'idx_orders_sync_job']
  }

  // CHECK chk_orders_amounts_nonneg: subtotal_amount >= 0 AND tax_amount >= 0 AND discount_amount >= 0 AND shipping_charged_amount >= 0 AND total_amount >= 0 AND marketplace_fees_amount >= 0 AND payment_processing_fees_amount >= 0 AND shipping_cost_amount >= 0 AND cogs_amount >= 0 AND refunded_amount >= 0 AND reporting_total_amount >= 0
  // CHECK chk_orders_refund_within_total: refunded_amount <= total_amount
  // CHECK chk_orders_exchange_rate_positive: exchange_rate > 0

  Note: 'Order header. Idempotent marketplace imports rely on (seller_account_id, external_order_id). P&L fields follow documented metric definitions (see docs/FINANCE_MODEL.md).'
}

Table order_line_items {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  order_id varchar(64) [not null, ref: > orders.id, note: 'ON DELETE CASCADE']
  product_variant_id varchar(64) [null, ref: > product_variants.id, note: 'ON DELETE SET NULL · SET NULL keeps sales history when a SKU is removed']
  channel_listing_id varchar(64) [null, ref: > channel_listings.id, note: 'ON DELETE SET NULL']
  external_order_line_id varchar(150) [null]
  sku varchar(120) [not null]
  title varchar(255) [not null]
  variant_title varchar(255) [null]
  asin varchar(20) [null]
  quantity_ordered integer [not null]
  quantity_fulfilled integer [not null, default: 0]
  quantity_returned integer [not null, default: 0]
  quantity_cancelled integer [not null, default: 0]
  currency_code varchar(3) [not null, default: 'USD']
  unit_price decimal(14,2) [not null, default: 0.00]
  discount_amount decimal(14,2) [not null, default: 0.00]
  tax_amount decimal(14,2) [not null, default: 0.00]
  shipping_amount decimal(14,2) [not null, default: 0.00]
  line_total_amount decimal(14,2) [not null, default: 0.00]
  unit_cost_amount decimal(14,2) [not null, default: 0.00]
  marketplace_fee_amount decimal(14,2) [not null, default: 0.00]
  refunded_amount decimal(14,2) [not null, default: 0.00]
  fulfillment_status fulfillment_status [not null, default: 'unfulfilled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    order_id [name: 'idx_order_line_items_order']
    product_variant_id [name: 'idx_order_line_items_variant']
    (order_id, external_order_line_id) [unique, name: 'uq_order_line_items_ext_id', note: 'partial: WHERE external_order_line_id IS NOT NULL']
  }

  // CHECK chk_order_line_items_qty_ordered_positive: quantity_ordered > 0
  // CHECK chk_order_line_items_qty_bounds: quantity_fulfilled >= 0 AND quantity_returned >= 0 AND quantity_cancelled >= 0 AND quantity_fulfilled <= quantity_ordered AND quantity_returned <= quantity_ordered AND quantity_cancelled <= quantity_ordered
  // CHECK chk_order_line_items_amounts_nonneg: unit_price >= 0 AND discount_amount >= 0 AND tax_amount >= 0 AND shipping_amount >= 0 AND line_total_amount >= 0 AND unit_cost_amount >= 0 AND marketplace_fee_amount >= 0 AND refunded_amount >= 0

  Note: 'Order lines snapshot SKU/title/prices at sale time. Quantities track fulfillment, return and cancellation invariants.'
}

Table order_import_payloads {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  order_id varchar(64) [not null, ref: > orders.id, note: 'ON DELETE CASCADE']
  sync_job_id varchar(64) [null, ref: > sync_jobs.id, note: 'ON DELETE SET NULL']
  seller_account_id varchar(64) [null, ref: > seller_accounts.id, note: 'ON DELETE SET NULL']
  payload_hash varchar(64) [not null]
  payload_size_bytes integer [not null]
  raw_payload jsonb [not null]
  redacted_fields jsonb [not null, default: `[]`]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    order_id [name: 'idx_order_import_payloads_order']
    (user_id, payload_hash) [name: 'idx_order_import_payloads_hash']
  }

  // CHECK chk_order_import_payloads_size: payload_size_bytes >= 0 AND payload_size_bytes <= 262144

  Note: 'Raw marketplace payloads isolated from normalized order data, with size cap (256 KB), SHA-256 hash and PII/secret redaction metadata.'
}

Table customer_risk_signals {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  customer_id varchar(64) [not null, ref: > customers.id, note: 'ON DELETE CASCADE']
  order_id varchar(64) [null, ref: > orders.id, note: 'ON DELETE SET NULL']
  signal_type risk_signal_type [not null]
  severity risk_severity [not null, default: 'low']
  review_status risk_review_status [not null, default: 'pending_review']
  reason text [not null]
  evidence jsonb [not null, default: `{}`, note: 'Structured, explainable evidence for the signal']
  reviewed_by_user_id varchar(64) [null, ref: > users.id, note: 'ON DELETE SET NULL']
  reviewed_at timestamptz [null]
  review_notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, review_status) [name: 'idx_customer_risk_signals_status']
    customer_id [name: 'idx_customer_risk_signals_customer']
    order_id [name: 'idx_customer_risk_signals_order']
  }

  Note: 'Explainable fraud/risk signals requiring authorized manual review — never automatic customer bans.'
}

Table shipments {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  order_id varchar(64) [not null, ref: > orders.id, note: 'ON DELETE CASCADE']
  shipment_number varchar(100) [not null]
  carrier_code varchar(50) [not null]
  carrier_name varchar(150) [not null]
  service_level varchar(100) [null]
  tracking_number varchar(150) [null]
  third_party_tracking_number varchar(150) [null, note: '3PL/forwarder tracking (renamed from invalid "3pl_*" identifiers)']
  tracking_url text [null]
  third_party_tracking_url text [null]
  status shipment_status [not null, default: 'pending']
  packaging_type varchar(100) [null]
  length_cm decimal(14,2) [null]
  width_cm decimal(14,2) [null]
  height_cm decimal(14,2) [null]
  dead_weight_grams decimal(14,2) [null]
  volumetric_weight_grams decimal(14,2) [null, note: '(L*W*H)/5000*1000 g']
  billed_weight_grams decimal(14,2) [null, note: 'max(dead, volumetric)']
  currency_code varchar(3) [not null, default: 'USD']
  estimated_shipping_cost decimal(14,2) [not null, default: 0.00]
  actual_invoiced_cost decimal(14,2) [not null, default: 0.00]
  shipped_at timestamptz [null]
  estimated_delivery_at timestamptz [null]
  delivered_at timestamptz [null]
  delivery_notification_sent boolean [not null, default: false]
  notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, shipment_number) [unique, name: 'uq_shipments_user_number']
    order_id [name: 'idx_shipments_order']
    (user_id, status) [name: 'idx_shipments_user_status']
    tracking_number [name: 'idx_shipments_tracking']
  }

  Note: 'Parcel shipments: dimensions, dead/volumetric/billed weight, carrier tracking, delivery timestamps and customer notification flag.'
}

Table shipment_items {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  shipment_id varchar(64) [not null, ref: > shipments.id, note: 'ON DELETE CASCADE']
  order_line_item_id varchar(64) [not null, ref: > order_line_items.id, note: 'ON DELETE CASCADE']
  quantity_shipped integer [not null]
  serial_numbers jsonb [not null, default: `[]`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (shipment_id, order_line_item_id) [unique, name: 'uq_shipment_items_shipment_line']
    order_line_item_id [name: 'idx_shipment_items_order_line']
  }

  // CHECK chk_shipment_items_qty_positive: quantity_shipped > 0

  Note: 'Junction: one parcel can contain many order lines; one order line can split across many parcels (partial fulfillment).'
}

Table shipping_invoices {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  financial_account_id varchar(64) [null, ref: > financial_accounts.id, note: 'ON DELETE SET NULL']
  carrier_code varchar(50) [not null]
  carrier_name varchar(150) [not null]
  invoice_number varchar(100) [not null]
  currency_code varchar(3) [not null, default: 'USD']
  subtotal_amount decimal(14,2) [not null, default: 0.00]
  tax_amount decimal(14,2) [not null, default: 0.00]
  total_amount decimal(14,2) [not null, default: 0.00]
  paid_amount decimal(14,2) [not null, default: 0.00]
  variance_amount decimal(14,2) [not null, default: 0.00, note: 'Sum of billed - expected across lines']
  payment_status invoice_payment_status [not null, default: 'unpaid']
  reconciliation_status invoice_reconciliation_status [not null, default: 'unreconciled']
  invoice_date date [not null]
  due_date date [null]
  paid_at timestamptz [null]
  payment_reference varchar(150) [null]
  notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, carrier_code, invoice_number) [unique, name: 'uq_shipping_invoices_user_carrier_num']
    (user_id, payment_status) [name: 'idx_shipping_invoices_status']
    (user_id, due_date) [name: 'idx_shipping_invoices_due_date']
  }

  // CHECK chk_shipping_invoices_amounts_nonneg: subtotal_amount >= 0 AND tax_amount >= 0 AND total_amount >= 0 AND paid_amount >= 0

  Note: 'Carrier billing invoices; payment + reconciliation status with due dates and payment references.'
}

Table shipping_invoice_lines {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  shipping_invoice_id varchar(64) [not null, ref: > shipping_invoices.id, note: 'ON DELETE CASCADE']
  shipment_id varchar(64) [null, ref: > shipments.id, note: 'ON DELETE RESTRICT · RESTRICT preserves billing reconciliation history']
  tracking_number varchar(150) [null]
  charge_type shipping_charge_type [not null, default: 'base_freight']
  description varchar(255) [null]
  currency_code varchar(3) [not null, default: 'USD']
  expected_amount decimal(14,2) [not null, default: 0.00]
  billed_amount decimal(14,2) [not null, default: 0.00]
  variance_amount decimal(14,2) [not null, default: 0.00]
  allow_duplicate_charge boolean [not null, default: false, note: 'Opt-in explicit override for legitimately repeated charges']
  reconciliation_notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    shipping_invoice_id [name: 'idx_shipping_invoice_lines_invoice']
    (shipment_id, charge_type) [unique, name: 'uq_shipping_invoice_lines_shipment_charge', note: 'partial: WHERE shipment_id IS NOT NULL AND allow_duplicate_charge = false · Partial unique — prevents accidental double-billing']
  }

  Note: 'Charge lines (freight, fuel, duties, signature, ...) linked to shipments. Partial unique index prevents double-billing the same (shipment, charge_type) unless allow_duplicate_charge = true.'
}

Table return_requests {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  order_id varchar(64) [not null, ref: > orders.id, note: 'ON DELETE CASCADE']
  order_line_item_id varchar(64) [not null, ref: > order_line_items.id, note: 'ON DELETE CASCADE']
  customer_id varchar(64) [not null, ref: > customers.id, note: 'ON DELETE RESTRICT']
  rma_number varchar(100) [not null]
  external_return_id varchar(150) [null]
  status return_status [not null, default: 'requested']
  return_reason return_reason [not null, default: 'other']
  resolution_type return_resolution_type [not null, default: 'refund']
  quantity_requested integer [not null]
  quantity_approved integer [not null, default: 0]
  quantity_received integer [not null, default: 0]
  item_condition return_item_condition [null]
  restock_inventory boolean [not null, default: false]
  return_carrier varchar(100) [null]
  return_tracking_number varchar(150) [null]
  return_label_url text [null]
  currency_code varchar(3) [not null, default: 'USD']
  return_shipping_cost decimal(14,2) [not null, default: 0.00]
  restocking_fee_amount decimal(14,2) [not null, default: 0.00]
  refund_amount decimal(14,2) [not null, default: 0.00]
  replacement_order_id varchar(64) [null, ref: > orders.id, note: 'ON DELETE SET NULL']
  customer_comments text [null]
  internal_notes text [null]
  evidence_images jsonb [not null, default: `[]`]
  approval_history jsonb [not null, default: `[]`]
  reviewed_by_user_id varchar(64) [null, ref: > users.id, note: 'ON DELETE SET NULL']
  requested_at timestamptz [not null, default: `now()`]
  authorized_at timestamptz [null]
  received_at timestamptz [null]
  closed_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, rma_number) [unique, name: 'uq_return_requests_user_rma']
    (order_id, external_return_id) [unique, name: 'uq_return_requests_order_ext_id', note: 'partial: WHERE external_return_id IS NOT NULL']
    order_id [name: 'idx_return_requests_order']
    order_line_item_id [name: 'idx_return_requests_order_line']
    (user_id, status) [name: 'idx_return_requests_user_status']
  }

  // CHECK chk_return_requests_qty_valid: quantity_requested > 0 AND quantity_approved >= 0 AND quantity_received >= 0 AND quantity_approved <= quantity_requested AND quantity_received <= quantity_requested
  // CHECK chk_return_requests_amounts_nonneg: return_shipping_cost >= 0 AND restocking_fee_amount >= 0 AND refund_amount >= 0

  Note: 'RMA lifecycle per order line (requested -> authorized -> in_transit -> received -> inspected -> refunded/replacement_sent -> closed). Quantities validated against remaining returnable units.'
}

Table refund_transactions {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  order_id varchar(64) [not null, ref: > orders.id, note: 'ON DELETE CASCADE']
  order_line_item_id varchar(64) [null, ref: > order_line_items.id, note: 'ON DELETE SET NULL']
  return_request_id varchar(64) [null, ref: > return_requests.id, note: 'ON DELETE SET NULL']
  financial_account_id varchar(64) [null, ref: > financial_accounts.id, note: 'ON DELETE SET NULL']
  refund_number varchar(100) [not null]
  external_refund_id varchar(150) [null]
  status refund_status [not null, default: 'processed']
  currency_code varchar(3) [not null, default: 'USD']
  items_refund_amount decimal(14,2) [not null, default: 0.00]
  shipping_refund_amount decimal(14,2) [not null, default: 0.00]
  tax_refund_amount decimal(14,2) [not null, default: 0.00]
  restocking_fee_deducted decimal(14,2) [not null, default: 0.00]
  total_refund_amount decimal(14,2) [not null, default: 0.00, note: 'items + shipping + tax - restocking_fee']
  reason text [null]
  processed_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, refund_number) [unique, name: 'uq_refund_transactions_user_number']
    (order_id, external_refund_id) [unique, name: 'uq_refund_transactions_order_ext_id', note: 'partial: WHERE external_refund_id IS NOT NULL']
    order_id [name: 'idx_refund_transactions_order']
    return_request_id [name: 'idx_refund_transactions_return']
  }

  // CHECK chk_refund_transactions_amounts_nonneg: items_refund_amount >= 0 AND shipping_refund_amount >= 0 AND tax_refund_amount >= 0 AND restocking_fee_deducted >= 0 AND total_refund_amount >= 0

  Note: 'Auditable refunds linked to orders/returns/financial accounts. Double-refund protection is enforced in OrderService within a transaction plus CHECKs on amounts.'
}

Table marketplace_claims {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  order_id varchar(64) [not null, ref: > orders.id, note: 'ON DELETE CASCADE']
  seller_account_id varchar(64) [null, ref: > seller_accounts.id, note: 'ON DELETE SET NULL']
  customer_id varchar(64) [null, ref: > customers.id, note: 'ON DELETE SET NULL']
  claim_number varchar(100) [not null]
  external_claim_id varchar(150) [null]
  claim_type claim_type [not null, default: 'a_to_z_guarantee']
  status claim_status [not null, default: 'opened']
  currency_code varchar(3) [not null, default: 'USD']
  disputed_amount decimal(14,2) [not null, default: 0.00]
  seller_liability_amount decimal(14,2) [not null, default: 0.00]
  reason text [null]
  evidence_submitted jsonb [not null, default: `{}`]
  respond_by_at timestamptz [null]
  resolved_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, claim_number) [unique, name: 'uq_marketplace_claims_user_number']
    order_id [name: 'idx_marketplace_claims_order']
    (user_id, status) [name: 'idx_marketplace_claims_status']
  }

  Note: 'Marketplace disputes, A-to-Z guarantee claims and payment chargebacks with evidence and respond-by deadlines.'
}

Table financial_transactions {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  financial_account_id varchar(64) [null, ref: > financial_accounts.id, note: 'ON DELETE SET NULL']
  credit_card_id varchar(64) [null, ref: > credit_cards.id, note: 'ON DELETE SET NULL']
  finance_category_id varchar(64) [null, ref: > finance_categories.id, note: 'ON DELETE SET NULL']
  seller_account_id varchar(64) [null, ref: > seller_accounts.id, note: 'ON DELETE SET NULL']
  order_id varchar(64) [null, ref: > orders.id, note: 'ON DELETE SET NULL']
  product_variant_id varchar(64) [null, ref: > product_variants.id, note: 'ON DELETE SET NULL']
  shipping_invoice_id varchar(64) [null, ref: > shipping_invoices.id, note: 'ON DELETE SET NULL']
  reference_number varchar(100) [not null]
  transaction_type financial_transaction_type [not null]
  data_classification data_classification [not null, default: 'business']
  status financial_transaction_status [not null, default: 'posted']
  description varchar(255) [not null]
  vendor_or_payer varchar(200) [null]
  original_currency_code varchar(3) [not null, default: 'USD']
  original_amount decimal(14,2) [not null]
  exchange_rate decimal(18,8) [not null, default: 1.00000000]
  reporting_currency_code varchar(3) [not null, default: 'USD']
  reporting_amount decimal(14,2) [not null]
  tax_amount decimal(14,2) [not null, default: 0.00]
  transaction_date date [not null]
  conversion_date date [null]
  due_date date [null]
  settled_at timestamptz [null]
  reconciled_at timestamptz [null]
  receipt_url text [null]
  notes text [null]
  metadata jsonb [not null, default: `{}`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, reference_number) [unique, name: 'uq_financial_transactions_user_ref']
    (user_id, transaction_type, transaction_date) [name: 'idx_financial_transactions_user_type_date']
    (user_id, data_classification) [name: 'idx_financial_transactions_classification']
    order_id [name: 'idx_financial_transactions_order']
    seller_account_id [name: 'idx_financial_transactions_seller']
    credit_card_id [name: 'idx_financial_transactions_card']
    (user_id, status, due_date) [name: 'idx_financial_transactions_due']
  }

  // CHECK chk_financial_transactions_amounts_nonneg: original_amount >= 0 AND reporting_amount >= 0 AND tax_amount >= 0
  // CHECK chk_financial_transactions_rate_positive: exchange_rate > 0

  Note: 'Multi-currency journal/ledger entries. Original amount + exchange rate + reporting amount are stored together to prevent rounding drift; entries reference orders/cards/invoices so settlements are never double-counted as income.'
}

Table tasks_reminders {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  related_entity_type varchar(100) [null]
  related_entity_id varchar(64) [null]
  credit_card_id varchar(64) [null, ref: > credit_cards.id, note: 'ON DELETE SET NULL']
  title varchar(255) [not null]
  description text [null]
  task_type task_type [not null, default: 'general']
  priority task_priority [not null, default: 'medium']
  status task_status [not null, default: 'pending']
  due_at timestamptz [not null]
  remind_at timestamptz [null]
  completed_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, status, due_at) [name: 'idx_tasks_reminders_user_status_due']
    credit_card_id [name: 'idx_tasks_reminders_card']
  }

  Note: 'Actionable tasks/reminders: credit-card dues, invoice dues, returns/claims review, restock alerts.'
}

Table saved_views {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  module_key varchar(100) [not null]
  name varchar(150) [not null]
  filters jsonb [not null, default: `{}`]
  sort_config jsonb [not null, default: `{}`]
  columns_config jsonb [not null, default: `[]`]
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, module_key, name) [unique, name: 'uq_saved_views_user_module_name']
  }

  Note: 'User-defined saved filters, table layouts and dashboard preferences per module.'
}

Table outbox_events {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [null, ref: > users.id, note: 'ON DELETE CASCADE']
  aggregate_type varchar(100) [not null]
  aggregate_id varchar(64) [not null]
  event_type varchar(150) [not null]
  idempotency_key varchar(150) [not null, unique]
  correlation_id varchar(100) [null]
  payload jsonb [not null]
  status outbox_event_status [not null, default: 'pending']
  retry_count integer [not null, default: 0]
  max_retries integer [not null, default: 5]
  next_retry_at timestamptz [null]
  last_error text [null]
  processed_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (status, next_retry_at) [name: 'idx_outbox_events_status_retry']
    (aggregate_type, aggregate_id) [name: 'idx_outbox_events_aggregate']
  }

  // CHECK chk_outbox_events_retries_nonneg: retry_count >= 0 AND max_retries >= 0

  Note: 'Transactional outbox: events inserted in the same transaction as the aggregate change, then published with retries and dead-lettering.'
}

Table notifications {
  id varchar(64) [pk, note: 'ULID generated by generateEntityId()']
  user_id varchar(64) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  type varchar(100) [not null, note: 'e.g. shipment.delivered, invoice.due, risk.review']
  title varchar(255) [not null]
  body text [null]
  entity_type varchar(100) [null]
  entity_id varchar(64) [null]
  channel varchar(32) [not null, default: 'in_app', note: 'in_app | email | sms']
  recipient_address varchar(255) [null, note: 'Email/phone when channel != in_app']
  is_read boolean [not null, default: false]
  sent_at timestamptz [null]
  read_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, is_read, created_at) [name: 'idx_notifications_user_unread']
    (entity_type, entity_id) [name: 'idx_notifications_entity']
  }

  // CHECK chk_notifications_channel: channel IN ('in_app','email','sms')

  Note: 'In-app/email/SMS notification records (delivery messages, due reminders, review requests).'
}
