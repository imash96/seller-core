    shipment_id [name: 'idx_shipping_invoice_lines_shipment']
    (shipment_id, charge_type) [unique, name: 'uq_shipping_invoice_lines_shipment_charge', note: 'partial: ((shipment_id IS NOT NULL) AND (allow_duplicate_charge = false))']
