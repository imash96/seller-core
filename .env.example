# Copy to `.env` (development) — the checklist commands below read this file.
#   node ace generate:key   # writes a fresh APP_KEY
#
# Local PostgreSQL without a system install:
#   node pgstart.mjs        # embedded Postgres 18 on 127.0.0.1:5432 (user/password: postgres)
TZ=UTC
NODE_ENV=development
PORT=3333
HOST=localhost
LOG_LEVEL=info

# 32-byte base64 secret. Rotating it invalidates existing logins and the encrypted
# marketplace credentials, so keep it stable per environment.
APP_KEY=
APP_URL=http://localhost:3333

# cookie | memory | database
# `database` is required for session revocation (logout-everywhere, suspended users);
# `cookie` keeps working for plain logins but cannot revoke an issued session.
SESSION_DRIVER=database

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/seller_core

# The test suite refuses to run unless this points at a dedicated database: it is
# migrated and reverted per run, so it must never be the development or production DB.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/seller_core_test